# Vercel frontend: set these as server-side environment variables.
# The ready-to-use values are in the local, ignored .env.vercel file.
VAULTLENS_BACKEND_URL=https://vaultlens-api-production.up.railway.app
VAULTLENS_BACKEND_TOKEN=
# Use the same token as Railway. Never add NEXT_PUBLIC_ to either name.
# Do not set VAULTLENS_ROLE=backend or NUGEN_API_KEY on the frontend.
